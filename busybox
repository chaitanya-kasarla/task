apiVersion: apps/v1
kind: Deployment
metadata:
  name: busybox-demo
spec:
  replicas: 2
  selector:
    matchLabels:
      app: busybox
  template:
    metadata:
      labels:
        app: busybox
    spec:
      containers:
      - name: busybox
        image: busybox
        command:
        - sh
        - -c
        - sleep 3600
        resources:
          requests:
            cpu: "100m"
          limits:
            cpu: "500m"
